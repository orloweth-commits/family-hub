{
  "name": "family-hub",
  "version": "0.33.5",
  "private": true,
  "type": "module",
  "description": "A glassy, themeable family planner card for Home Assistant wall panels.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/check-looks.mjs && node scripts/check-motion.mjs && node scripts/check-type.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "check:looks": "node scripts/check-looks.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:type": "node scripts/check-type.mjs",
    "shots": "node scripts/shots.mjs",
    "test:fit": "node scripts/tests/audit.mjs",
    "test:click": "node scripts/tests/click-base.mjs && node scripts/tests/click-music.mjs",
    "test:phone": "node scripts/tests/phone.mjs",
    "test:art": "node scripts/tests/art.mjs",
    "test:phase1": "node scripts/tests/phase1.mjs",
    "test:phase2": "node scripts/tests/phase2.mjs",
    "test:phase3": "node scripts/tests/phase3.mjs",
    "test:buttons": "node scripts/tests/buttons.mjs",
    "test:ask": "node scripts/tests/ask.mjs",
    "test:phase4": "node scripts/tests/phase4.mjs",
    "test:trust": "node scripts/tests/trust.mjs",
    "check": "node scripts/check.mjs",
    "check:broad": "node scripts/check.mjs --broad",
    "check:full": "node scripts/check.mjs --full",
    "test:voice": "node scripts/tests/voice.mjs",
    "test:screensaver": "node scripts/tests/screensaver.mjs"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
